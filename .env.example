# Copy to `.env` and fill in. `.env` is git-ignored.
# The app itself needs no local env file: Render gets its config from render.yaml
# and the dashboard. These are only for the helper scripts in tests/.

# tests/qase/upload.mjs (Qase test-case uploader)
QASE_API_TOKEN=
QASE_PROJECT=FM

# Jira MCP (mcp-atlassian in .agents/mcp.json); the API token comes from https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_USERNAME=
JIRA_API_TOKEN=
