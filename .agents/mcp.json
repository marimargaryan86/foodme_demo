{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.83",
        "--browser",
        "chrome",
        "--user-data-dir",
        ".playwright-profile",
        "--output-dir",
        ".playwright-mcp",
        "--viewport-size",
        "1440x900",
        "--snapshot-mode",
        "none",
        "--image-responses",
        "omit"
      ],
      "env": {}
    },
    "qase": {
      "command": "npx",
      "args": [
        "-y",
        "@qase/mcp-server"
      ],
      "env": {
        "QASE_API_TOKEN": "${QASE_API_TOKEN}"
      }
    },
    "agentsecrets": {
      "command": "agentsecrets",
      "args": [
        "mcp",
        "serve"
      ]
    },
    "mcp-atlassian": {
      "command": "uvx",
      "args": [
        "mcp-atlassian"
      ],
      "env": {
        "JIRA_URL": "https://marimargaryan86.atlassian.net",
        "JIRA_USERNAME": "${JIRA_USERNAME}",
        "JIRA_API_TOKEN": "${JIRA_API_TOKEN}"
      }
    }
  }
}
